# Existing AI provider (optional; Land Intelligence GIS core does not require it)
GEMINI_API_KEY=

# Existing PostgreSQL compatibility (optional; SQLite is the default)
DATABASE_URL=
DB_PATH=./data/land_records.db

# Existing authentication secret; set a strong private value in deployments
JWT_SECRET=

# Optional map provider configuration; default demo uses OpenStreetMap-compatible tiles
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION=© OpenStreetMap contributors
MAP_MAX_ZOOM=19
MAP_MIN_ZOOM=3

# Area comparison tolerance for land-property checks
LAND_AREA_TOLERANCE_HA=0.05
