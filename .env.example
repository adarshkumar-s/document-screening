APP_ENV=development

# Production browser origins, comma-separated. Required when APP_ENV=production.
ALLOWED_ORIGINS=http://localhost:8000

# Existing AI provider (optional; the mapping workspace does not require it)
GEMINI_API_KEY=

# Existing PostgreSQL compatibility (optional; SQLite is the default).
# In production, a configured DATABASE_URL must point at a reachable PostgreSQL
# server and the psycopg2 driver must be installed: the server fails closed at
# startup instead of silently falling back to SQLite.
DATABASE_URL=
DB_PATH=./data/land_records.db

# Authentication secret; required in production and must be a long random private value.
JWT_SECRET=

# Optional first-run administrator bootstrap. No default admin password is stored in source.
ADMIN_INITIAL_PASSWORD=

# Secret used for short-lived administrator action tokens; required in production.
ADMIN_ACTION_SECRET=

# Secret phrase that unlocks the Superior Administrator (SA) mode in the AI assistant.
# Keep private. In production this must be configured; never commit the real value.
SA_ACTIVATION_CODE=
# Applies to SA sessions (Admin AI security lock and Superior SA mode).
SA_SESSION_TTL_SECONDS=3600
SA_MODEL=gemini-3.6-flash

# Argon2id hashes for the three separate SA identity passwords.
# Never put the plaintext passwords in source control or browser code.
SA_PASSWORD_HASH_GAUTAM=
SA_PASSWORD_HASH_ADARSH=
SA_PASSWORD_HASH_DEVI_CR=

# Optional map provider configuration; the browser map defaults to keyless global HOT tiles
MAP_TILE_URL=https://{s}.tile.openstreetmap.fr/hot/{z}/{x}/{y}.png
MAP_ATTRIBUTION=© OpenStreetMap contributors · HOT tiles courtesy of Humanitarian OpenStreetMap Team
MAP_MAX_ZOOM=19
MAP_MIN_ZOOM=3

# Area comparison tolerance for land-property checks
LAND_AREA_TOLERANCE_HA=0.05

# SA gateway (Admin AI security lock) access password — optional bootstrap.
# Stored only as an argon2id hash; never logged or returned. Empty means the
# administrator configures/rotates the credential via the admin endpoint.
SA_ACCESS_PASSWORD=

# How long an SA assistant request waits for its worker before the client is
# given a timeout envelope with the real "Try again" (clamp 0.2–120 seconds).
SA_REQUEST_WAIT_SECONDS=25

# ---------------------------------------------------------------------------
# Abuse limits (security_hardening). Defaults are production-safe; raise them
# only behind a proxy that collapses many clients onto one IP. A value that is
# empty, unparseable or non-positive falls back to the default rather than
# disabling the limit.
# ---------------------------------------------------------------------------
RATE_LIMIT_AUTH_WINDOW_SECONDS=900
RATE_LIMIT_AUTH_MAX_ATTEMPTS=10
RATE_LIMIT_SIGNUP_WINDOW_SECONDS=3600
RATE_LIMIT_SIGNUP_MAX_ATTEMPTS=5
RATE_LIMIT_MULTIPART_WINDOW_SECONDS=3600
RATE_LIMIT_MULTIPART_MAX_ATTEMPTS=20
# Comma-separated proxy IPs whose X-Forwarded-For is trusted for per-client
# limits. Never trust this header from an untrusted peer.
TRUSTED_PROXY_IPS=

# ---------------------------------------------------------------------------
# Extraction-state thresholds (extraction_states.py). These decide when an OCR
# result is reported as EXTRACTION_SUCCESS versus NEEDS_HUMAN_REVIEW. Defaults
# match the confidence conventions used by field validation.
# ---------------------------------------------------------------------------
# Mean field confidence at or above which extraction counts as successful.
EXTRACTION_MIN_SUCCESS_CONFIDENCE=0.65
# Minimum number of required identity fields that must be non-empty.
EXTRACTION_MIN_REQUIRED_FIELDS=2
# A transcript shorter than this is treated as blank, not sparse.
EXTRACTION_MIN_TRANSCRIPT_CHARS=20
